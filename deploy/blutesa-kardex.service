[Unit]
Description=Kardex BLUTESA (gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=blutesa
Group=blutesa
WorkingDirectory=/opt/blutesa-kardex
EnvironmentFile=/opt/blutesa-kardex/.env
ExecStart=/opt/blutesa-kardex/.venv/bin/gunicorn config.wsgi:application \
    --workers 3 \
    --bind 127.0.0.1:8030 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
