# Copia este archivo a .env (o configura estas variables directamente en el panel de tu
# proveedor de hosting) cuando despliegues en la nube. En desarrollo local no hace falta nada de
# esto — el proyecto ya trae valores por defecto que funcionan igual que siempre.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com

# Contraseñas reales de los 4 usuarios iniciales del equipo, usadas por
# `python manage.py sembrar_datos` (build.sh la corre en cada deploy) para crearlos sin
# necesitar Shell. El que no tenga su variable definida se omite, no rompe el build.
# <PREFIJO>_NOMBRE / <PREFIJO>_APELLIDO son opcionales, solo para el nombre completo.
LUIS_PASSWORD=
DAYMALIS_PASSWORD=
JULIO_PASSWORD=
ELMER_PASSWORD=

# Si el proxy que sirve HTTPS (Render, tailscale serve, etc.) no manda el header que Django
# necesita para reconocer que la conexión es segura, la redirección automática a HTTPS entra en
# loop (ERR_TOO_MANY_REDIRECTS) y ni siquiera se puede cargar la página para depurar. Por defecto
# está en True (más seguro); si ves ese loop, ponlo en False acá.
DJANGO_SECURE_SSL_REDIRECT=True

# PostgreSQL de producción. Con cualquiera de las dos opciones de abajo el proyecto deja de usar
# SQLite. Si tu proveedor (ej. Render) te da una sola cadena de conexión, usa DATABASE_URL — es
# lo más simple. Si prefieres los campos sueltos, usa las 5 variables POSTGRES_*.
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# Alternativa a DATABASE_URL, por si tu proveedor solo te da los campos sueltos:
POSTGRES_DB=blutesa_kardex
POSTGRES_USER=blutesa_kardex
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Notificaciones push (PWA). Genéralas una sola vez con:
#   .venv/Scripts/python.exe manage.py generar_claves_vapid
# y pega el resultado aquí (en local, si las dejas vacías se generan y guardan solas).
# VAPID_CLAIM_EMAIL debe ser un dominio/correo REAL — Apple Web Push (Safari/iOS) rechaza con
# "403 BadJwtToken" cualquier dominio inventado (.local, .localhost, etc).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:contacto@blutesa.example

# Nextcloud (fotos de evidencia de Órdenes de Trabajo). Si las dejas vacías, el módulo de
# Órdenes de Trabajo guarda las fotos en el servidor local en vez de Nextcloud — solo para
# desarrollo, en producción configúralas.
NEXTCLOUD_WEBDAV_URL=https://tu-nextcloud.example/remote.php/dav/files/usuario-app
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_UPLOAD_FOLDER=OrdenesTrabajo
